# Supabase project URL used to call the hosted form-submit Edge Function.
NEXT_PUBLIC_SUPABASE_URL=https://tdbsuzciwotleualdcjf.supabase.co

# Optional: enables build-time reads from the Supabase content catalog.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional for local/review builds; a token is required by the production deploy workflow.
# Prefer the current PostHog token name. The legacy API key name remains supported.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_API_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
