{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drmexperienced.com/schemas/dropbox-delivery.json",
  "title": "Dr. M Dropbox publishing delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deliveryId",
    "createdAt",
    "episodeNumber",
    "episodeSlug",
    "manifest",
    "assets",
    "readyForPreparation",
    "authorizesUpload",
    "authorizesRelease"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "deliveryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "episodeNumber": { "type": "integer", "minimum": 1 },
    "episodeSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manifest": {
      "allOf": [
        { "$ref": "#/$defs/fileRecord" },
        { "type": "object", "properties": { "file": { "const": "episode.json" } } }
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "fullVideo": { "$ref": "#/$defs/fileRecord" },
        "podcastAudio": { "$ref": "#/$defs/fileRecord" },
        "instagramReel": { "$ref": "#/$defs/fileRecord" },
        "thumbnail": { "$ref": "#/$defs/fileRecord" },
        "captions": { "$ref": "#/$defs/fileRecord" }
      }
    },
    "readyForPreparation": { "const": true },
    "authorizesUpload": { "const": false },
    "authorizesRelease": { "const": false }
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "sizeBytes"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
