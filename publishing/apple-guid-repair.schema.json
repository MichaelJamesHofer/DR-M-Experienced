{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drmexperienced.com/schemas/apple-guid-repair.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "discoveredAt",
    "lastVerifiedAt",
    "feedUrl",
    "appleShowId",
