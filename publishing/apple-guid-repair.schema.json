  "$defs": {
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeNumber",
        "slug",
        "title",
        "rssComEpisodeId",
        "appleEpisodeId",
        "spotifyEpisodeId",
        "currentFeedGuid",
        "appleHistoricalGuid"
      ],
      "properties": {
        "episodeNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/nonBlank"
        },
        "rssComEpisodeId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "appleEpisodeId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "spotifyEpisodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{22}$"
        },
        "currentFeedGuid": {
          "$ref": "#/$defs/uuid"
        },
        "appleHistoricalGuid": {
          "$ref": "#/$defs/uuid"
        }
      }
    }
  }
}
