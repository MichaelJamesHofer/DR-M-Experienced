            },
            "recipient": {
              "const": "support@rss.com"
            },
            "subject": {
              "$ref": "#/$defs/nonBlank"
            },
            "request": {
              "$ref": "#/$defs/nonBlank"
            },
            "responseSummary": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        },
        "spotify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "submittedAt",
            "lastFollowedUpAt",
            "lastResponseAt",
            "channel",
            "advisor",
            "request"
          ],
          "properties": {
            "status": {
              "const": "advisor_investigating_pending_technical_response"
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time"
            },
            "lastFollowedUpAt": {
              "type": "string",
              "format": "date-time"
            },
            "lastResponseAt": {
              "type": "string",
              "format": "date-time"
            },
            "channel": {
              "$ref": "#/$defs/nonBlank"
            },
            "advisor": {
              "$ref": "#/$defs/nonBlank"
            },
            "request": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        }
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/episode"
      }
