    "status": {
      "enum": [
        "apple_only_overlay_approved_pending_deployment",
        "feed_deployed_pending_apple_switch",
        "apple_processing",
        "verified_complete"
      ]
    },
    "discoveredAt": {
      "type": "string",
      "format": "date"
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date"
    },
    "feedUrl": {
      "const": "https://media.rss.com/dr-m-experienced/feed.xml"
    },
    "appleShowId": {
      "const": "1870433419"
    },
    "appleContentProviderId": {
      "const": "128469457"
    },
    "appleCaseNumber": {
      "const": "20000130526608"
    },
    "relatedAppleCaseNumbers": {
      "type": "array",
      "prefixItems": [
        {
          "const": "20000144016176"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "summary",
        "localBaselineLimitation"
      ],
      "properties": {
        "provider": {
          "const": "Apple Podcasts Support"
        },
        "summary": {
          "$ref": "#/$defs/nonBlank"
        },
        "localBaselineLimitation": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "repairMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "configPath",
        "sourceFeedUrl",
        "publicFeedUrl",
        "appleShowId",
        "appleContentProviderId",
        "githubPagesRequiredBuildType",
        "allowedMutations",
        "approval"
      ],
      "properties": {
        "type": {
          "const": "apple_only_guid_overlay"
        },
        "configPath": {
          "const": "publishing/apple-feed-overlay.json"
        },
        "sourceFeedUrl": {
          "const": "https://media.rss.com/dr-m-experienced/feed.xml"
        },
        "publicFeedUrl": {
          "const": "https://drmexperienced.com/apple-podcasts/feed.xml"
        },
        "appleShowId": {
          "const": "1870433419"
        },
        "appleContentProviderId": {
          "const": "128469457"
        },
        "githubPagesRequiredBuildType": {
          "const": "workflow"
        },
        "allowedMutations": {
          "type": "array",
          "prefixItems": [
            {
              "const": "channel.atom:link[rel=self].href"
            },
            {
              "const": "episode-1.guid"
            },
            {
              "const": "episode-2.guid"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvedAt",
            "approvedBy",
            "scope",
            "acceptedRisks"
          ],
          "properties": {
            "approvedAt": {
              "type": "string",
              "format": "date-time"
            },
            "approvedBy": {
              "const": "owner"
            },
            "scope": {
              "$ref": "#/$defs/nonBlank"
            },
            "acceptedRisks": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonBlank"
              }
            }
          }
        }
      }
    },
    "supportOutreach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apple",
        "rssCom",
        "spotify"
      ],
      "properties": {
        "apple": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "submittedAt",
            "channel",
            "caseNumber",
            "relatedCaseNumbers",
            "request"
          ],
          "properties": {
            "status": {
              "const": "engineering_escalation_pending_response"
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time"
