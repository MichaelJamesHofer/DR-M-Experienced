{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drmexperienced.com/schemas/apple-guid-repair.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "discoveredAt",
    "lastVerifiedAt",
    "feedUrl",
    "appleShowId",
    "appleCaseNumber",
    "sourceEvidence",
    "supportOutreach",
    "episodes",
    "gates",
    "constraints",
    "nextActions"
  ],
  "properties": {
    "$schema": {
      "const": "./apple-guid-repair.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "status": {
      "const": "tri_provider_review_pending_remote_change_blocked"
    },
    "discoveredAt": {
      "type": "string",
      "format": "date"
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date"
    },
    "feedUrl": {
      "const": "https://media.rss.com/dr-m-experienced/feed.xml"
    },
    "appleShowId": {
      "const": "1870433419"
    },
    "appleCaseNumber": {
      "const": "20000130526608"
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "summary",
        "localBaselineLimitation"
      ],
      "properties": {
        "provider": {
          "const": "Apple Podcasts Support"
        },
        "summary": {
          "$ref": "#/$defs/nonBlank"
        },
        "localBaselineLimitation": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "supportOutreach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apple",
        "rssCom",
        "spotify"
      ],
      "properties": {
        "apple": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "submittedAt",
            "channel",
            "caseNumber",
            "request"
          ],
          "properties": {
            "status": {
              "const": "submitted_pending_response"
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time"
            },
            "channel": {
              "$ref": "#/$defs/nonBlank"
            },
            "caseNumber": {
              "const": "20000130526608"
            },
            "request": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        },
        "rssCom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "submittedAt",
            "channel",
            "recipient",
            "subject",
            "request"
          ],
          "properties": {
            "status": {
              "const": "sent_pending_response"
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time"
            },
            "channel": {
              "$ref": "#/$defs/nonBlank"
            },
            "recipient": {
              "const": "support@rss.com"
            },
            "subject": {
              "$ref": "#/$defs/nonBlank"
            },
            "request": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        },
        "spotify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "submittedAt",
            "lastFollowedUpAt",
            "lastResponseAt",
            "channel",
            "advisor",
            "request"
          ],
          "properties": {
            "status": {
              "const": "advisor_investigating_pending_technical_response"
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time"
            },
            "lastFollowedUpAt": {
              "type": "string",
              "format": "date-time"
            },
            "lastResponseAt": {
              "type": "string",
              "format": "date-time"
            },
            "channel": {
              "$ref": "#/$defs/nonBlank"
            },
            "advisor": {
              "$ref": "#/$defs/nonBlank"
            },
            "request": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        }
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/episode1"
          },
          {
            "$ref": "#/$defs/episode2"
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/episode1"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/episode2"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appleSupportCrosswalkRecorded",
        "appleTitleMappingIndependentlyVerified",
        "rssComInPlaceEditConfirmed",
        "spotifyImpactReviewed",
        "spotifyIdentityPreservationConfirmed",
        "exactRemoteChangeApproved",
        "beforeSnapshotCaptured",
        "remoteWritePerformed",
        "feedVerified",
        "appleIdentityPreserved",
        "spotifyIdentityPreserved"
      ],
      "properties": {
        "appleSupportCrosswalkRecorded": {
          "const": true
        },
        "appleTitleMappingIndependentlyVerified": {
          "type": "boolean"
        },
        "rssComInPlaceEditConfirmed": {
          "type": "boolean"
        },
        "spotifyImpactReviewed": {
          "const": true
        },
        "spotifyIdentityPreservationConfirmed": {
          "type": "boolean"
        },
        "exactRemoteChangeApproved": {
          "type": "boolean"
        },
        "beforeSnapshotCaptured": {
          "type": "boolean"
        },
        "remoteWritePerformed": {
          "type": "boolean"
        },
        "feedVerified": {
          "type": "boolean"
        },
        "appleIdentityPreserved": {
          "type": "boolean"
        },
        "spotifyIdentityPreserved": {
          "type": "boolean"
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "tri_provider_review_pending_remote_change_blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "gates": {
            "type": "object",
            "properties": {
              "exactRemoteChangeApproved": {
                "const": false
              },
              "remoteWritePerformed": {
                "const": false
              },
              "feedVerified": {
                "const": false
              },
              "appleIdentityPreserved": {
                "const": false
              },
              "spotifyIdentityPreserved": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeNumber",
        "slug",
        "title",
        "rssComEpisodeId",
        "appleEpisodeId",
        "spotifyEpisodeId",
        "currentFeedGuid",
        "appleHistoricalGuid"
      ],
      "properties": {
        "episodeNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/nonBlank"
        },
        "rssComEpisodeId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "appleEpisodeId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "spotifyEpisodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{22}$"
        },
        "currentFeedGuid": {
          "$ref": "#/$defs/uuid"
        },
        "appleHistoricalGuid": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "episode1": {
      "allOf": [
        {
          "$ref": "#/$defs/episode"
        },
        {
          "type": "object",
          "properties": {
            "episodeNumber": {
              "const": 1
            },
            "slug": {
              "const": "brain-fog-part-1"
            },
            "title": {
              "const": "Brain Fog, Part 1 - Is Your Brain in a Fog?"
            },
            "rssComEpisodeId": {
              "const": "3050766"
            },
            "appleEpisodeId": {
              "const": "1000746628307"
            },
            "spotifyEpisodeId": {
              "const": "7cAdb8GE4khC9EYKAjmYuc"
            },
            "currentFeedGuid": {
              "const": "c9b853b6-a828-4012-9998-217919ff9163"
            },
            "appleHistoricalGuid": {
              "const": "59063e08-e4a6-4e56-b7ec-d2a66d69beb8"
            }
          }
        }
      ]
    },
    "episode2": {
      "allOf": [
        {
          "$ref": "#/$defs/episode"
        },
        {
          "type": "object",
          "properties": {
            "episodeNumber": {
              "const": 2
            },
            "slug": {
              "const": "brain-fog-part-2"
            },
            "title": {
              "const": "Brain Fog, Part 2 - Testing and Basic Solutions"
            },
            "rssComEpisodeId": {
              "const": "3050765"
            },
            "appleEpisodeId": {
              "const": "1000746628422"
            },
            "spotifyEpisodeId": {
              "const": "19Pct0ClX3j1EOwJ3ySVd7"
            },
            "currentFeedGuid": {
              "const": "1e40e02b-b217-477c-9cc3-4271cb304c23"
            },
            "appleHistoricalGuid": {
              "const": "26896da2-76cf-4865-93f8-f94ddfb24568"
            }
          }
        }
      ]
    }
  }
}
