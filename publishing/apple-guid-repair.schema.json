        "manifestPath": {
          "const": "publishing/evidence/apple-guid-repair-before-20260824T191935Z.json"
        },
        "rawEvidenceDirectory": {
          "const": ".drm-publisher/evidence/apple-guid-repair/20260824T191935Z"
        },
        "sourceFeedSha256": {
          "const": "60f25c3bb1d27784534839a978614984152febdb17b53fe66a5bdec6224e1fdf"
        },
        "sourceFeedSizeBytes": {
          "const": 21702
        },
        "sourceEpisodeCount": {
          "const": 7
        },
        "applePublicSha256": {
          "const": "4976b1e869e6aaefb8ee8b47d6bc9e3d4df3b3d47c3e7d00b44923917529a1c0"
        },
        "applePublicSizeBytes": {
          "const": 225529
        },
        "applePublicEpisodeCount": {
          "const": 5
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appleSupportCrosswalkRecorded",
        "appleTitleMappingIndependentlyVerified",
        "rssComInPlaceEditAvailable",
        "spotifyImpactReviewed",
        "userAcceptedAppleIdentityRisk",
        "overlayLocallyValidated",
        "exactRemoteChangeApproved",
        "beforeSnapshotCaptured",
        "githubPagesWorkflowModeVerified",
        "remoteWritePerformed",
        "overlayPublished",
        "feedVerified",
        "sourceFeedUnchangedAfterDeploymentVerified",
        "appleFeedUrlChanged",
        "appleRefreshRequested",
        "appleExistingShowPreserved",
        "applePublicSevenEpisodesVerified",
        "applePlaybackVerified"
      ],
      "properties": {
        "appleSupportCrosswalkRecorded": {
          "const": true
        },
        "appleTitleMappingIndependentlyVerified": {
          "const": true
        },
        "rssComInPlaceEditAvailable": {
          "const": false
        },
        "spotifyImpactReviewed": {
          "const": true
        },
        "userAcceptedAppleIdentityRisk": {
          "const": true
        },
        "overlayLocallyValidated": {
          "const": true
        },
        "exactRemoteChangeApproved": {
          "const": true
        },
        "beforeSnapshotCaptured": {
          "const": true
        },
        "githubPagesWorkflowModeVerified": {
          "type": "boolean"
