        "remoteWritePerformed": {
          "type": "boolean"
        },
        "overlayPublished": {
          "type": "boolean"
        },
        "feedVerified": {
          "type": "boolean"
        },
        "sourceFeedUnchangedAfterDeploymentVerified": {
          "type": "boolean"
        },
        "appleFeedUrlChanged": {
          "type": "boolean"
        },
        "appleRefreshRequested": {
          "type": "boolean"
        },
        "appleExistingShowPreserved": {
          "type": "boolean"
        },
        "applePublicSevenEpisodesVerified": {
          "type": "boolean"
        },
        "applePlaybackVerified": {
          "type": "boolean"
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "apple_only_overlay_approved_pending_deployment"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "gates": {
            "type": "object",
            "properties": {
              "githubPagesWorkflowModeVerified": {
                "const": false
              },
              "remoteWritePerformed": {
                "const": false
              },
              "overlayPublished": {
                "const": false
              },
              "feedVerified": {
                "const": false
              },
              "sourceFeedUnchangedAfterDeploymentVerified": {
                "const": false
              },
              "appleFeedUrlChanged": {
                "const": false
              },
              "appleRefreshRequested": {
                "const": false
              },
              "appleExistingShowPreserved": {
                "const": false
              },
              "applePublicSevenEpisodesVerified": {
                "const": false
              },
              "applePlaybackVerified": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "feed_deployed_pending_apple_switch"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "gates": {
            "type": "object",
            "properties": {
              "githubPagesWorkflowModeVerified": { "const": true },
              "remoteWritePerformed": { "const": true },
              "overlayPublished": { "const": true },
              "feedVerified": { "const": true },
              "sourceFeedUnchangedAfterDeploymentVerified": { "const": true },
              "appleFeedUrlChanged": { "const": false },
              "appleRefreshRequested": { "const": false },
              "appleExistingShowPreserved": { "const": false },
              "applePublicSevenEpisodesVerified": { "const": false },
              "applePlaybackVerified": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "apple_processing"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "gates": {
            "type": "object",
            "properties": {
              "githubPagesWorkflowModeVerified": { "const": true },
              "remoteWritePerformed": { "const": true },
              "overlayPublished": { "const": true },
              "feedVerified": { "const": true },
              "sourceFeedUnchangedAfterDeploymentVerified": { "const": true },
              "appleFeedUrlChanged": { "const": true },
              "appleExistingShowPreserved": { "const": true },
              "applePublicSevenEpisodesVerified": { "const": false },
              "applePlaybackVerified": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified_complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "gates": {
            "type": "object",
            "properties": {
              "githubPagesWorkflowModeVerified": { "const": true },
              "remoteWritePerformed": { "const": true },
              "overlayPublished": { "const": true },
              "feedVerified": { "const": true },
              "sourceFeedUnchangedAfterDeploymentVerified": { "const": true },
              "appleFeedUrlChanged": { "const": true },
              "appleExistingShowPreserved": { "const": true },
              "applePublicSevenEpisodesVerified": { "const": true },
              "applePlaybackVerified": { "const": true }
            }
          }
        }
      }
    }
